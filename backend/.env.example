# Copy to backend/.env.local and fill in (it overrides backend/.env). Never commit either file.

# --- Gnani (app.gnani.ai → API keys). Leave empty or set SPEECH_PROVIDER=mock to run without it.
GNANI_API_KEY=
SPEECH_PROVIDER=gnani
PRISMA_MODEL=prisma-v3.0
TIMBRE_MODEL=timbre-v3.0
TIMBRE_FALLBACK_MODEL=timbre-v2.5
TIMBRE_VOICE_FEMALE=Shivani
TIMBRE_VOICE_MALE=Avinash
# Raise only if Gnani gives your account more parallel requests
GNANI_CONCURRENCY=1

# --- LLM for translation, gist and replies: anthropic | gemini | mock
LLM_PROVIDER=anthropic
# Used when the primary has no key or a call fails: anthropic | gemini | none
LLM_FALLBACK_PROVIDER=gemini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase (optional locally; counters + feedback only)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Web app origin(s) allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# --- Limits
NOTES_PER_DAY=10
REPLIES_PER_DAY=5
DAILY_STT_SECONDS_CAP=6000
DAILY_TTS_CHARS_CAP=60000

# --- WhatsApp bot via Meta Cloud API (optional; bot is off while WA_ACCESS_TOKEN is empty)
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=pick-any-long-random-string
WA_GRAPH_VERSION=v23.0
# Your own number(s), country code first, no "+", comma-separated. Empty = anyone who can reach the bot.
WA_ALLOWED_NUMBERS=
WA_HASH_SALT=pick-another-long-random-string

# --- WhatsApp bot via Twilio (no Facebook account needed; bot is off while TWILIO_ACCOUNT_SID is empty)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# webhook = legacy-Console sandbox calls /twilio/webhook; poll = trial "Try out WhatsApp" number (no webhook)
TWILIO_MODE=webhook
# api = send replies via REST (legacy sandbox, paid numbers); twiml = reply inside the webhook response
# (trial "Try out WhatsApp" number, which rejects REST sends with error 21654)
TWILIO_REPLY=api
# Public HTTPS address of this API (ngrok / cloudflared tunnel, or Cloud Run). No trailing slash.
PUBLIC_API_URL=
